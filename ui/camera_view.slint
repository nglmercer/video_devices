import { Button, ComboBox, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component CameraView inherits Window {
    title: "Camera";
    width: 800px;
    height: 600px;

    // Callbacks for Rust integration
    callback refresh-cameras();
    callback start-camera();
    callback stop-camera();
    callback update-frame(); // Timer callback

    // Properties from Rust
    in-out property <[string]> cameras: [];
    in-out property <image> camera-frame;
    in-out property <bool> camera-active: false;
    in-out property <int> selected-camera-index: 0;
    in-out property <string> status-text: "Ready";
    in-out property <bool> is-streaming: false;
    in-out property <int> fps: 0;

    // Optimized timer with adaptive interval
    Timer {
        interval: 16ms; // 60 FPS base rate for smoother updates
        running: camera-active;
        triggered => {
            root.update-frame();
        }
    }

    VerticalBox {
        spacing: 10px;
        padding: 10px;

        // Camera display area
        Rectangle {
            background: #333333;
            border-width: 2px;
            border-color: #666;
            min-height: 400px;

            // Debug info overlay
            if (camera-active) : Rectangle {
                x: 10px;
                y: 10px;
                width: 250px;
                height: 100px;
                background: rgba(0, 0, 0, 0.8);
                border-radius: 4px;
                border-width: 1px;
                border-color: #333;

                VerticalLayout {
                    spacing: 4px;
                    padding: 8px;

                    Text {
                        text: "📹 Camera Active";
                        color: #0f0;
                        font-size: 14px;
                        font-weight: 700;
                    }

                    Text {
                        text: "📺 Frame: " + camera-frame.width + "x" + camera-frame.height;
                        color: white;
                        font-size: 11px;
                    }

                    Text {
                        text: is-streaming ? "🔄 Streaming @ " + fps + " FPS" : "⏸️ Paused";
                        color: is-streaming ? #0f0 : #f00;
                        font-size: 11px;
                    }

                    Text {
                        text: "🎬 Mode: Direct (Ultra-Fast)";
                        color: #0af;
                        font-size: 11px;
                    }

                    Text {
                        text: status-text;
                        color: #aaa;
                        font-size: 10px;
                    }
                }
            }

            // Camera frame display
            if (camera-active && camera-frame.width > 0) : Image {
                source: camera-frame;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }

            // Placeholder when no camera
            if (!camera-active) : Text {
                text: "No Camera Active\n\nSelect a camera and click 'Start' to begin";
                color: #999;
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // Status bar
        Rectangle {
            height: 30px;
            background: #222;
            border-radius: 3px;

            HorizontalLayout {
                padding: 5px;

                Text {
                    text: status-text;
                    color: camera-active ? #0f0 : #999;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        // Control panel
        HorizontalBox {
            spacing: 10px;

            ComboBox {
                model: cameras;
                enabled: !camera-active;
                current-index <=> root.selected-camera-index;
                width: 250px;
            }

            Button {
                text: camera-active ? "⏹️ Stop" : "▶️ Start";
                enabled: cameras.length > 0;

                clicked => {
                    if (camera-active) {
                        root.stop-camera();
                    } else {
                        root.start-camera();
                    }
                }
            }

            Button {
                text: "🔄 Refresh";
                enabled: !camera-active;
                clicked => {
                    root.refresh-cameras();
                }
            }

            Rectangle {
                width: 120px;
                height: 35px;
                background: #2a2a2a;
                border-radius: 4px;
                border-width: 1px;
                border-color: #444;

                Text {
                    text: "🚀 Ultra-Fast Mode";
                    color: #00a8ff;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    height: 100%;
                    font-weight: 600;
                }
            }
        }
    }
}
