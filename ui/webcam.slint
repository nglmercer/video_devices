import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component WebcamView inherits Window {
    title: "Webcam View";
    width: 900px;
    height: 700px;
    
    // Callbacks for Rust integration
    callback start-camera();
    callback stop-camera();
    callback update-frame(); // Timer callback
    callback back-to-config();
    
    // Properties from Rust
    in-out property <image> camera-frame;
    in-out property <bool> camera-active: false;
    in-out property <string> status-text: "Ready";
    in-out property <bool> is-streaming: false;
    in-out property <int> fps: 0;
    in-out property <string> camera-name: "No Camera";
    in-out property <string> resolution-info: "Unknown";
    in-out property <string> fps-info: "0 FPS";
    
    // Optimized timer with adaptive interval
    Timer {
        interval: 33ms; // ~30 FPS for better performance
        running: camera-active;
        triggered => {
            root.update-frame();
        }
    }
    
    VerticalBox {
        spacing: 10px;
        padding: 10px;
        
        // Header with camera info
        Rectangle {
            height: 80px;
            background: #2c3e50;
            border-radius: 8px;
            
            HorizontalLayout {
                padding: 15px;
                spacing: 20px;
                
                VerticalLayout {
                    spacing: 5px;
                    
                    Text {
                        text: "📹 " + camera-name;
                        color: white;
                        font-size: 18px;
                        font-weight: 600;
                    }
                    
                    Text {
                        text: resolution-info + " @ " + fps-info;
                        color: #ecf0f1;
                        font-size: 14px;
                    }
                }
                
                Rectangle {
                    width: 2px;
                    background: #7f8c8d;
                }
                
                VerticalLayout {
                    spacing: 5px;
                    
                    Text {
                        text: is-streaming ? "🔴 LIVE" : "⏸️ PAUSED";
                        color: is-streaming ? #e74c3c : #f39c12;
                        font-size: 16px;
                        font-weight: 600;
                    }
                    
                    Text {
                        text: "FPS: " + fps;
                        color: #ecf0f1;
                        font-size: 14px;
                    }
                }
            }
        }
        
        // Camera display area
        Rectangle {
            background: #1a1a1a;
            border-width: 2px;
            border-color: #444;
            border-radius: 8px;
            min-height: 450px;
            
            // Camera frame display
            if (camera-active && camera-frame.width > 0) : Image {
                source: camera-frame;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }
            
            // Placeholder when no camera
            if (!camera-active) : Rectangle {
                width: 100%;
                height: 100%;
                
                VerticalLayout {
                    spacing: 20px;
                    alignment: center;
                    
                    Rectangle {
                        width: 80px;
                        height: 80px;
                        background: #333;
                        border-radius: 40px;
                        
                        Text {
                            text: "📹";
                            font-size: 40px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    
                    Text {
                        text: "No Camera Active\n\nClick 'Start Camera' to begin streaming";
                        color: #999;
                        font-size: 18px;
                        horizontal-alignment: center;
                    }
                }
            }
            
            // Streaming indicator overlay
            if (camera-active && is-streaming) : Rectangle {
                x: 15px;
                y: 15px;
                width: 120px;
                height: 35px;
                background: rgba(231, 76, 60, 0.9);
                border-radius: 20px;
                
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    alignment: center;
                    
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        background: white;
                        border-radius: 6px;
                    }
                    
                    Text {
                        text: "LIVE";
                        color: white;
                        font-size: 14px;
                        font-weight: 600;
                    }
                }
            }
        }
        
        // Status bar
        Rectangle {
            height: 35px;
            background: #2c3e50;
            border-radius: 5px;
            
            HorizontalLayout {
                padding-left: 15px;
                padding-right: 15px;
                padding-top: 8px;
                padding-bottom: 8px;
                
                Text {
                    text: status-text;
                    color: camera-active ? #2ecc71 : #95a5a6;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
        
        // Control panel
        HorizontalBox {
            spacing: 15px;
            
            Button {
                text: "⚙️ Back to Config";
                clicked => {
                    root.back-to-config();
                }
            }
            
            Rectangle {
                width: 1px;
                background: #bdc3c7;
            }
            
            Button {
                text: camera-active ? "⏹️ Stop Camera" : "▶️ Start Camera";
                enabled: true;
                
                clicked => {
                    if (camera-active) {
                        root.stop-camera();
                    } else {
                        root.start-camera();
                    }
                }
            }
            
            // Camera controls (only active when streaming)
            if (camera-active) : HorizontalBox {
                spacing: 10px;
                
                Button {
                    text: is-streaming ? "⏸️ Pause" : "▶️ Resume";
                    clicked => {
                        root.is-streaming = !root.is-streaming;
                    }
                }
                
                Button {
                    text: "📸 Snapshot";
                    clicked => {
                        root.status-text = "Snapshot saved (feature coming soon)";
                    }
                }
            }
        }
    }
}