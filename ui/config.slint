import { Button, ComboBox, VerticalBox, HorizontalBox, CheckBox, SpinBox } from "std-widgets.slint";

export component ConfigView inherits Window {
    title: "Camera Configuration";
    width: 600px;
    height: 500px;
    
    // Callbacks for Rust integration
    callback refresh-cameras();
    callback get-camera-capabilities();
    callback save-config();
    callback start-webcam-view();
    
    // Properties from Rust
    in-out property <[string]> cameras: [];
    in-out property <[string]> resolutions: [];
    in-out property <[string]> fps-options: [];
    in-out property <int> selected-camera-index: 0;
    in-out property <int> selected-resolution-index: 0;
    in-out property <int> selected-fps-index: 0;
    in-out property <string> status-text: "Ready";
    in-out property <bool> auto-detect: true;
    in-out property <bool> is-loading: false;
    
    VerticalBox {
        spacing: 15px;
        padding: 20px;
        
        // Title
        Text {
            text: "Camera Configuration";
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            color: #333;
        }
        
        // Camera Selection
        Rectangle {
            background: #f9f9f9;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ddd;
            
            VerticalLayout {
                spacing: 10px;
                padding: 15px;
                
                Text {
                    text: "Camera Selection";
                    font-size: 16px;
                    font-weight: 600;
                    color: #333;
                }
                
                HorizontalBox {
                    spacing: 10px;
                    alignment: start;
                    
                    CheckBox {
                        text: "Auto-detect best camera";
                        checked <=> auto-detect;
                        enabled: !is-loading;
                    }
                    
                    Button {
                        text: "🔄 Refresh";
                        enabled: !is-loading && !auto-detect;
                        clicked => {
                            root.is-loading = true;
                            root.refresh-cameras();
                        }
                    }
                }
                
                ComboBox {
                    model: cameras;
                    enabled: !auto-detect && !is-loading;
                    current-index <=> selected-camera-index;
                    width: 100%;
                }
            }
        }
        
        // Resolution Selection
        Rectangle {
            background: #f9f9f9;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ddd;
            
            VerticalLayout {
                spacing: 10px;
                padding: 15px;
                
                Text {
                    text: "Resolution & Frame Rate";
                    font-size: 16px;
                    font-weight: 600;
                    color: #333;
                }
                
                Text {
                    text: "Resolution:";
                    font-weight: 600;
                }
                
                ComboBox {
                    model: resolutions;
                    enabled: !is-loading;
                    current-index <=> selected-resolution-index;
                    width: 100%;
                }
                
                Text {
                    text: "Frame Rate (FPS):";
                    font-weight: 600;
                }
                
                ComboBox {
                    model: fps-options;
                    enabled: !is-loading;
                    current-index <=> selected-fps-index;
                    width: 100%;
                }
                
                HorizontalBox {
                    spacing: 10px;
                    
                    CheckBox {
                        text: "Use maximum resolution at 30 FPS";
                        checked: true;
                        enabled: !is-loading;
                        toggled => {
                            root.get-camera-capabilities();
                        }
                    }
                }
            }
        }
        
        // Status Display
        Rectangle {
            height: 60px;
            background: #f5f5f5;
            border-radius: 5px;
            border-width: 1px;
            border-color: #ddd;
            
            HorizontalLayout {
                padding: 10px;
                
                if (is-loading) : Rectangle {
                    width: 20px;
                    height: 20px;
                    background: #007acc;
                    border-radius: 10px;
                }
                
                Text {
                    text: status-text;
                    color: #666;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
        }
        
        // Action Buttons
        HorizontalBox {
            spacing: 10px;
            alignment: end;
            
            Button {
                text: "💾 Save Config";
                enabled: !is-loading && cameras.length > 0;
                clicked => {
                    root.save-config();
                }
            }
            
            Button {
                text: "📹 Start Webcam";
                enabled: !is-loading && cameras.length > 0;
                clicked => {
                    root.start-webcam-view();
                }
            }
        }
    }
}